{
  "manifest_version": 3,
  "name": "탭 모아",
  "version": "1.1.0",
  "description": "탭 그룹과 즐겨찾기를 저장하고 태그로 정리해 다시 엽니다.",
  "minimum_chrome_version": "111",
  "permissions": ["storage", "tabGroups", "activeTab", "scripting"],
  "action": {
    "default_title": "탭 모아",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
